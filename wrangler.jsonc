{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-wars",
  "main": "src/royale/worker.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },

  // The domain. `custom_domain` makes Cloudflare manage the DNS record and
  // certificate for each hostname; both must already be zones on the account.
  "routes": [
    { "pattern": "mcpagentwars.com", "custom_domain": true },
    { "pattern": "www.mcpagentwars.com", "custom_domain": true }
  ],

  // One Durable Object per arena: a single authoritative writer for each match,
  // which is what makes the event feed ordered and the state races impossible.
  "durable_objects": {
    "bindings": [
      { "name": "ARENA", "class_name": "Arena" },
      // One global instance, holding accounts and the cross-arena record.
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Arena"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ]
}
